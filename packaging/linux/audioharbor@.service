[Unit]
Description=Audio Harbor Headless (%i)
Documentation=https://github.com/petergerov/audio-harbor-headless
Wants=network-online.target
# remote-fs.target: start after NFS / SMB shares in /etc/fstab are mounted.
After=network-online.target remote-fs.target sound.target

[Service]
Type=simple
User=%i
# harbor-drives: may run the drive helper through sudo (web remote → Set Up drive).
SupplementaryGroups=audio harbor-drives
# Config, catalogue and PIN live in ~%i/.audio-harbor-headless — same as a manual start.
ExecStart=/opt/audio-harbor-headless/start.sh serve
Restart=on-failure
RestartSec=5
# Leave time for mDNS goodbye packets on stop.
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
