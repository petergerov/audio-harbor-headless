#!/bin/sh
# Fresh install: enable the service for the installing user.
# Upgrade: restart the instances that run.
set -e

pick_user() {
  u="${HARBOR_USER:-${SUDO_USER:-}}"
  if [ -z "$u" ] || [ "$u" = "root" ]; then
    u="$(getent passwd 1000 | cut -d: -f1 || true)"
  fi
  if [ -n "$u" ] && id "$u" >/dev/null 2>&1; then
    echo "$u"
  fi
}

# The service gets this group; sudoers lets it run the drive and update helpers.
if [ "$1" = "configure" ] && ! getent group harbor-drives >/dev/null; then
  groupadd --system harbor-drives
fi

# Raspberry Pi: the start signal sets a GPIO (/dev/gpiochip*, /dev/gpiomem: group gpio).
add_gpio() {
  if getent group gpio >/dev/null && id "$1" >/dev/null 2>&1 && ! id -nG "$1" | tr ' ' '\n' | grep -qx gpio; then
    usermod -aG gpio "$1" || true
  fi
}

if [ "$1" = "configure" ]; then
  for unit in /etc/systemd/system/multi-user.target.wants/audioharbor@*.service; do
    [ -e "$unit" ] || continue
    u="${unit##*/audioharbor@}"
    add_gpio "${u%.service}"
  done
fi

if [ "$1" = "configure" ] && [ -d /run/systemd/system ]; then
  systemctl daemon-reload || true
  if [ -z "$2" ]; then
    user="$(pick_user)"
    if [ -n "$user" ]; then
      add_gpio "$user"
      systemctl enable --now "audioharbor@${user}.service" || true
      echo "Audio Harbor Headless runs as ${user} (service audioharbor@${user})."
      echo "Remote: http://ahh.local:8887 — PIN: audioharbor pair"
    else
      echo "Start it for a user with: sudo systemctl enable --now audioharbor@<user>"
    fi
  else
    systemctl try-restart 'audioharbor@*.service' || true
  fi
fi

exit 0
