#!/bin/bash
# Root helper for the web remote: puts a drive or an SMB share into /etc/fstab and
# mounts it read-only under /mnt/harbor/<name>. The service runs it through sudo
# (/etc/sudoers.d/audio-harbor-headless, group harbor-drives).
#
#   harbor-drive add <UUID> <name>   fstab entry + mount, owned by the calling user
#   harbor-drive add-smb <name>      the same for an SMB share; reads five lines on stdin:
#                                    server, share, domain, user, password (user empty: guest)
#   harbor-drive remove <name>       unmount, drop the fstab entry, mount point and credentials
#   harbor-drive eject <name>        unmount — safe to unplug; mounts again on access
#
# Only touches fstab entries below /mnt/harbor/. Errors go to stderr, one line.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022

BASE=/mnt/harbor
FSTAB=/etc/fstab
MARK="# audio-harbor-headless drive"
# SMB credentials, one root-only file per share — never in fstab.
CRED_DIR=/etc/audio-harbor-headless

die() { echo "$*" >&2; exit 1; }
trap 'echo "harbor-drive: unexpected failure (line $LINENO)" >&2' ERR

[[ "$(id -u)" -eq 0 ]] || die "harbor-drive must run as root"
[[ -d /run/systemd/system ]] || die "systemd is not running"

exec 9>/run/lock/harbor-drive.lock
flock -w 30 9 || die "another drive change is still running"

valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$ ]]; }
valid_uuid() { [[ "$1" =~ ^[A-Za-z0-9-]{1,64}$ ]]; }
valid_host() { [[ "$1" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,252})$ ]]; }
# Share names may hold spaces; fstab gets them as \040.
valid_share() { [[ "$1" =~ ^[A-Za-z0-9_\$]([A-Za-z0-9._\$\ -]{0,79})$ ]]; }
valid_domain() { [[ -z "$1" || "$1" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,63}$ ]]; }
valid_user() { [[ -z "$1" || "$1" =~ ^[A-Za-z0-9._@-]{1,64}$ ]]; }

calling_user_ids() {
  uid="${SUDO_UID:-}"
  gid="${SUDO_GID:-}"
  [[ "$uid" =~ ^[0-9]+$ && "$gid" =~ ^[0-9]+$ ]] || die "run through sudo"
}

# fstab line of a mount point below $BASE, empty when there is none.
fstab_entry() { awk -v mp="$1" '$1 !~ /^#/ && $2 == mp' "$FSTAB"; }

units_for() {
  automount_unit="$(systemd-escape --path --suffix=automount "$1")"
  mount_unit="$(systemd-escape --path --suffix=mount "$1")"
}

# New fstab next to the old one, then rename — never a half-written fstab.
write_fstab() {
  local tmp="$FSTAB.harbor-tmp"
  cat > "$tmp"
  chmod 644 "$tmp"
  cp -p "$FSTAB" "$FSTAB.harbor-backup"
  mv "$tmp" "$FSTAB"
}

drop_entry() {
  awk -v mp="$1" -v mark="$MARK" '
    $0 == mark { held = $0; next }
    $1 !~ /^#/ && $2 == mp { held = ""; next }
    held != "" { print held; held = "" }
    { print }
    END { if (held != "") print held }
  ' "$FSTAB" | write_fstab
}

cmd_add() {
  local uuid="${1:-}" name="${2:-}"
  valid_uuid "$uuid" || die "invalid UUID"
  valid_name "$name" || die "invalid name — letters, digits, . _ - (up to 32)"
  local mp="$BASE/$name"
  local dev
  dev="$(blkid -U "$uuid" 2>/dev/null)" || die "no drive with UUID $uuid is connected"

  [[ -z "$(fstab_entry "$mp")" ]] || die "$mp is already in use"
  grep -Eq "^[[:space:]]*UUID=\"?$uuid\"?[[:space:]]" "$FSTAB" && die "this drive is already in /etc/fstab"

  # Never the disk the system runs from.
  local disk root_src root_disk
  disk="$(lsblk -no PKNAME "$dev" 2>/dev/null | head -1 || true)"; disk="${disk:-$(basename "$dev")}"
  root_src="$(findmnt -no SOURCE / || true)"
  root_disk="$(lsblk -no PKNAME "${root_src%%\[*}" 2>/dev/null | head -1 || true)"
  [[ -n "$root_disk" && "$disk" == "$root_disk" ]] && die "this is the system disk"

  # Mounted by the desktop under /media: take it over. Anything else: leave it alone.
  local current
  while read -r current; do
    [[ -z "$current" ]] && continue
    [[ "$current" == /media/* ]] || die "$dev is in use at $current"
    umount "$current" || die "could not unmount $current"
  done < <(lsblk -no MOUNTPOINTS "$dev")

  local fs uid gid type opts
  fs="$(blkid -s TYPE -o value "$dev")"
  calling_user_ids
  local owner="uid=$uid,gid=$gid,umask=022"
  case "$fs" in
    exfat) type=exfat; opts="ro,$owner" ;;
    vfat) type=vfat; opts="ro,$owner,utf8" ;;
    ntfs)
      if modprobe -q ntfs3 2>/dev/null || grep -qw ntfs3 /proc/filesystems; then type=ntfs3
      elif command -v ntfs-3g >/dev/null 2>&1; then type=ntfs-3g
      else die "NTFS needs the ntfs3 kernel module or ntfs-3g (sudo apt install ntfs-3g)"
      fi
      opts="ro,$owner" ;;
    ext2|ext3|ext4|btrfs|xfs) type="$fs"; opts=ro ;;
    "") die "$dev has no file system" ;;
    *) die "file system $fs is not supported" ;;
  esac
  # Boot does not wait for the drive; an unplugged drive fails fast instead of after 90 s.
  opts="$opts,nofail,x-systemd.automount,x-systemd.device-timeout=5s,x-systemd.mount-timeout=30s"

  activate "UUID=$uuid" "$mp" "$type" "$opts" "$dev"
}

# Adds the fstab line, mounts it once to check; on failure everything is undone.
activate() {
  local spec="$1" mp="$2" type="$3" opts="$4" what="$5"
  mkdir -p "$mp"
  { cat "$FSTAB"; printf '%s\n%s  %s  %s  %s  0  0\n' "$MARK" "$spec" "$mp" "$type" "$opts"; } | write_fstab

  units_for "$mp"
  systemctl daemon-reload
  if ! systemctl restart "$automount_unit" || ! ls "$mp" >/dev/null 2>&1 \
      || [[ "$(findmnt -no FSTYPE "$mp" | tail -1)" == autofs ]]; then
    local why
    why="$( { journalctl -b -u "$mount_unit" -n 5 -o cat --no-pager 2>/dev/null || true; } \
      | grep -iE 'error|denied|refused|no such|unreachable|timed out' | tail -1 || true)"
    systemctl stop "$automount_unit" "$mount_unit" 2>/dev/null || true
    drop_entry "$mp"
    systemctl daemon-reload
    rmdir "$mp" 2>/dev/null || true
    rm -f "$CRED_DIR/$(basename "$mp").cred"
    die "could not mount $what${why:+ — $why}"
  fi
  echo "$mp"
}

cmd_add_smb() {
  local name="${1:-}"
  valid_name "$name" || die "invalid name — letters, digits, . _ - (up to 32)"
  local server share domain user password
  IFS= read -r server || true
  IFS= read -r share || true
  IFS= read -r domain || true
  IFS= read -r user || true
  IFS= read -r password || true
  share="${share#/}"; share="${share%/}"
  valid_host "$server" || die "invalid server — a name like nas.local or an IP address"
  valid_share "$share" || die "invalid share name"
  valid_domain "$domain" || die "invalid domain"
  valid_user "$user" || die "invalid user name"
  [[ "$password" != *$'\r'* ]] || die "invalid password"
  command -v mount.cifs >/dev/null 2>&1 || die "SMB needs cifs-utils: sudo apt install cifs-utils"

  local mp="$BASE/$name"
  [[ -z "$(fstab_entry "$mp")" ]] || die "$mp is already in use"
  local uid gid
  calling_user_ids

  local opts="ro,uid=$uid,gid=$gid,file_mode=0444,dir_mode=0555,iocharset=utf8"
  if [[ -n "$user" ]]; then
    local cred="$CRED_DIR/$name.cred"
    mkdir -p "$CRED_DIR"
    chmod 700 "$CRED_DIR"
    ( umask 077
      printf 'username=%s\npassword=%s\n' "$user" "$password" > "$cred"
      [[ -n "$domain" ]] && printf 'domain=%s\n' "$domain" >> "$cred"
      true )
    opts="$opts,credentials=$cred"
  else
    opts="$opts,guest"
  fi
  # Boot does not wait for the network share; an unreachable server fails within 15 s.
  opts="$opts,nofail,_netdev,x-systemd.automount,x-systemd.mount-timeout=15s"
  activate "//$server/${share// /\\040}" "$mp" cifs "$opts" "//$server/$share"
}

cmd_remove() {
  local name="${1:-}"
  valid_name "$name" || die "invalid name"
  local mp="$BASE/$name"
  [[ -n "$(fstab_entry "$mp")" ]] || die "$mp is not set up"
  units_for "$mp"
  systemctl stop "$automount_unit" "$mount_unit" 2>/dev/null || true
  mountpoint -q "$mp" && { umount "$mp" || die "$mp is busy"; }
  drop_entry "$mp"
  systemctl daemon-reload
  rmdir "$mp" 2>/dev/null || true
  rm -f "$CRED_DIR/$name.cred"
}

cmd_eject() {
  local name="${1:-}"
  valid_name "$name" || die "invalid name"
  local mp="$BASE/$name"
  [[ -n "$(fstab_entry "$mp")" ]] || die "$mp is not set up"
  units_for "$mp"
  systemctl stop "$mount_unit" || die "$mp is busy"
  sync
}

case "${1:-}" in
  add) shift; cmd_add "$@" ;;
  add-smb) shift; cmd_add_smb "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  eject) shift; cmd_eject "$@" ;;
  *) die "usage: harbor-drive add <UUID> <name> | add-smb <name> (stdin) | remove <name> | eject <name>" ;;
esac
