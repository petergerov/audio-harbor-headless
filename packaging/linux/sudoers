# Audio Harbor Headless: the service (group harbor-drives, given by audioharbor@.service)
# may set up drives in /etc/fstab and install a newer release from the web remote.
# The helpers check their arguments.
%harbor-drives ALL=(root) NOPASSWD: /usr/libexec/audio-harbor-headless/harbor-drive, /usr/libexec/audio-harbor-headless/harbor-update
